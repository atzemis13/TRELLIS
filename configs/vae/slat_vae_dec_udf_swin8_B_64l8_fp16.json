{
    "models": {
        "decoder": {
            "name": "ElasticSLatUDFDecoder",
            "args": {
                "resolution": 64,
                "model_channels": 768,
                "latent_channels": 8,
                "num_blocks": 12,
                "num_heads": 12,
                "mlp_ratio": 4,
                "attn_mode": "swin",
                "window_size": 8,
                "use_fp16": true,
                "representation_config": {
                    "normalize_udf": true
                }
            }
        }
    },
    "dataset": {
        "name": "SLat2UDF",
        "args": {
            "latent_model": "dinov2_vitl14_reg_slat_enc_swin8_B_64l8_fp16",
            "num_surface_points": 10000,
            "min_aesthetic_score": 4.5,
            "max_num_voxels": 32768,
            "normalize_udf": true,
            "augment_points": true
        }
    },
    "trainer": {
        "name": "SLatVaeUDFDecoderTrainer",
        "args": {
            "max_steps": 1000000,
            "batch_size_per_gpu": 1,
            "batch_split": 1,
            "optimizer": {
                "name": "AdamW",
                "args": {
                    "lr": 1e-4,
                    "weight_decay": 0.0
                }
            },
            "ema_rate": [
                0.9999
            ],
            "fp16_mode": "inflat_all",
            "fp16_scale_growth": 0.001,
            "elastic": {
                "name": "LinearMemoryController",
                "args": {
                    "target_ratio": 0.75,
                    "max_mem_ratio_start": 0.5
                }
            },
            "grad_clip": {
                "name": "AdaptiveGradClipper",
                "args": {
                    "max_norm": 1.0,
                    "clip_percentile": 95
                }
            },
            "i_log": 500,
            "i_sample": 100,
            "i_save": 1000,
            "loss_type": "smooth_l1",
            "lambda_reg": 0.1,
            "lambda_edge_weight": 2.0,
            "edge_threshold": 0.05,
            "normalize_udf": true
        }
    }
}
